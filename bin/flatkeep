#!/usr/bin/env python3
# Installed to /app/bin, where the package lives in /app/share/flatkeep.
# In a source checkout the package sits next to bin/ instead.
import os
import sys

prefix = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
sys.path[:0] = [os.path.join(prefix, "share", "flatkeep"), prefix]

from flatkeep.__main__ import main  # noqa: E402

sys.exit(main())
